---
// Zoomable coverage map. Squares: src/data/coverage.json. Streets: OpenStreetMap tiles.
// Leaflet loads from unpkg, pinned with SRI: the site's one third-party exception (see CLAUDE.md, server/csp.js).
// Repeater pins: src/data/repeater-sites.json (locations only, no names).
// The map starts hidden; the script shows it once the map can load, so without
// JavaScript (or if loading fails) there is no empty box. The legend and summary always show.
// not-content: keeps Starlight's spacing between page elements out of Leaflet's map layers.
import { coverage, repeaterSites } from '../lib/data.js';
import { uniqueCells } from '../lib/coverage-map.js';

// compact: a shorter map, for the home page column.
const { compact = false } = Astro.props;
// The compact map has no summary under it, so its name points to the repeater list instead.
const label = compact
  ? 'Coverage map. You can zoom in to street level. The repeater list describes coverage in words.'
  : 'Coverage map. You can zoom in to street level. The summary below says the same in words.';

const cells = JSON.stringify(uniqueCells(coverage.cells));
const sites = JSON.stringify(repeaterSites.map(({ lat, lon }) => ({ lat, lon })));
const asOf = new Date(`${coverage.asOf}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<figure class:list={['mm-coverage-figure', { 'mm-coverage-figure--compact': compact }]}>
  <div class="mm-coverage-map not-content" hidden role="region" aria-label={label} data-cells={cells} data-repeaters={sites}></div>
  <figcaption>
    <ul class="mm-cov-legend">
      <li><svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"><rect class="mm-cov-reached" x="1" y="1" width="14" height="14" /></svg> Reached a repeater</li>
      <li><svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"><circle class="mm-repeater-swatch" cx="8" cy="8" r="6" /></svg> Repeater</li>
    </ul>
    {!compact && <p>Last updated {asOf}. Coverage changes with weather, hills, and your antenna, so treat this as a rough guide.{Astro.slots.has('default') && <> <slot /></>}</p>}
  </figcaption>
</figure>

<script>
  import { startCoverageMap } from '../scripts/coverage-map-client.js';
  for (const el of document.querySelectorAll('.mm-coverage-map')) {
    startCoverageMap(el).catch((err) => {
      el.hidden = true;
      console.warn('Coverage map could not load:', err);
    });
  }
</script>

<style>
  .mm-coverage-figure { margin: 1rem 0 1.5rem; max-width: 100%; }
  .mm-coverage-map {
    height: min(60vh, 480px);
    min-height: 260px;
    background: var(--mm-map-bg);
    border: 1px solid var(--mm-line);
    border-radius: 0.25rem;
  }
  /* Home page: a shorter map beside the blurb, with a quieter caption. */
  /* Home page. Wide screens: the map is exactly as tall as the text beside it, and the legend hangs just
     under the map, outside that height, so the map's top and bottom line up with the text. */
  .mm-coverage-figure--compact { margin: 0; }
  .mm-coverage-figure--compact .mm-coverage-map { height: 260px; }
  .mm-coverage-figure--compact figcaption { margin-top: 0.5rem; }
  .mm-coverage-figure--compact .mm-cov-legend { margin-top: 0; }
  @media (min-width: 50rem) {
    .mm-coverage-figure--compact { position: relative; height: 100%; }
    .mm-coverage-figure--compact .mm-coverage-map { height: 100%; min-height: 220px; }
    .mm-coverage-figure--compact figcaption { position: absolute; top: 100%; left: 0; right: 0; }
  }
  .mm-coverage-figure--compact figcaption { font-size: 0.875rem; color: var(--mm-muted); }
  .mm-coverage-map:focus-visible { outline: 3px solid var(--mm-focus); outline-offset: 2px; }
  .mm-coverage-map :global(.leaflet-bar a:focus-visible) { outline: 3px solid var(--mm-focus); outline-offset: 1px; }
  /* Dark theme: OpenStreetMap only has light tiles, so darken them with a filter. */
  :global(:root[data-theme='dark']) .mm-coverage-map :global(.leaflet-tile-pane) { filter: invert(1) hue-rotate(180deg) brightness(0.9) contrast(0.9); }
  .mm-coverage-map :global(.leaflet-control-attribution) { background: var(--mm-paper); color: var(--mm-ink); }
  .mm-coverage-map :global(.leaflet-control-attribution a) { color: inherit; text-decoration: underline; }
  .mm-cov-legend { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .mm-cov-legend li { display: flex; align-items: center; gap: 0.5rem; margin: 0; }
  .mm-cov-legend svg { flex: none; margin: 0; background: var(--mm-map-bg); }
  .mm-cov-reached { fill: var(--mm-cov-reached); fill-opacity: 0.35; stroke: var(--mm-cov-reached); stroke-width: 1.5; }
  .mm-repeater-swatch { fill: var(--mm-map-repeater); stroke: var(--mm-map-repeater-ring); stroke-width: 2; }
</style>
