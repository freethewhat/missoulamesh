---
import { settings } from '../lib/data.js';
import { channelKey } from '../lib/channels.js';
---
<table>
  <thead><tr><th scope="col">Channel</th><th scope="col">What it is for</th><th scope="col">Key</th></tr></thead>
  <tbody>
    {settings.channels.map((c) => (
      <tr>
        <th scope="row"><code>{c.name}</code></th>
        <td>{c.purpose}</td>
        <td>{c.type === 'hashtag' ? <code>{channelKey(c.name)}</code> : 'Built in'}</td>
      </tr>
    ))}
  </tbody>
</table>
