---
// Devices from hardware.json. Pick by ids, or by role and whether someone in the valley has used one.
import { hardware } from '../lib/data.js';
import { pickHardware } from '../lib/hardware.js';
interface Props { role?: 'companion' | 'repeater'; triedHere?: boolean; ids?: string[] }
const items = pickHardware(hardware, Astro.props);
---
{items.length === 0 ? (
  <p class="mm-hw-empty">None listed right now.</p>
) : (
  <ul class="mm-hardware">
    {items.map((d) => (
      <li>
        <a class="mm-hw-name" href={d.url}>{d.name}</a>
        <span class="mm-hw-price">about ${Math.round(d.priceUSD)} <span class="mm-checked">(checked {d.lastChecked})</span></span>
        <p class="mm-hw-facts">{d.facts}</p>
      </li>
    ))}
  </ul>
)}
