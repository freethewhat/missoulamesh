---
import { repeaters } from '../lib/data.js';
import { repeaterDetails } from '../lib/repeater-details.js';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const label = { 'on-air': 'On the air', down: 'Down', unknown: 'Status unknown' };
---
{repeaters.length === 0 ? (
  <p>No repeaters are listed yet.</p>
) : (
  <ul class="mm-repeaters">
    {repeaters.map((r) => (
      <li data-status={r.status}>
        <span class="mm-area">{r.area}</span>
        <span class={`mm-tag mm-tag--${r.status}`}>{label[r.status]}</span>
        {!compact && repeaterDetails(r).map((d) => <p class="mm-notes"><strong>{d.label}:</strong> {d.value}</p>)}
      </li>
    ))}
  </ul>
)}
